# ==============================================================================
# Configuration Environnement Production - Vision IA Temps Réel
# ==============================================================================

# Environnement d'exécution : 'development' ou 'production'
ENVIRONMENT=production

# Obligation d'authentification pour les endpoints sensibles (true en production)
REQUIRE_AUTH=true

# Clé API principale (À MODIFIER IMPÉRATIVEMENT EN PRODUCTION)
# Générez une clé robuste : openssl rand -hex 24
ENTERPRISE_API_KEY=votre_cle_api_securisee_super_secrete_2026

# Origines CORS autorisées (séparées par une virgule, ou * en dev)
CORS_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# Paramètres serveur
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SERVER_SSL=true

# Limites de débit (Rate Limiting)
RATE_LIMIT_PER_MINUTE=120
